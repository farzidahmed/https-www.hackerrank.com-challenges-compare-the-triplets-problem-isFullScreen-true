#include <stdio.h>

int main() {
    int a[3];
    int b[3];


    for (int i = 0; i < 3; i++) {
        scanf("%d", &a[i]);
    }

  
    for (int i = 0; i < 3; i++) {
        scanf("%d", &b[i]);
    }

    int n = sizeof(a) / sizeof(a[0]);

    int alice = 0;
    int bob = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] > b[i]) {
            alice++;
        }
        else if (a[i] < b[i]) {
            bob++;
        }
    }

    printf("%d %d\n", alice, bob);

    return 0;
}
